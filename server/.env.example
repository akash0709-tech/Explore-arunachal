# Copy this file to server/.env and fill in real values.
# Never commit server/.env. It holds secrets.

# ---------- App ----------
# development | test | production
NODE_ENV=development
# Port the API listens on (the Vite proxy in client/ points here)
PORT=5000

# ---------- Database ----------
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/explore-arunachal?retryWrites=true&w=majority
# Optional: comma-separated DNS servers, only if "querySrv" errors appear on your network
DNS_SERVERS=

# ---------- Frontend ----------
# Exact origin of the React app. Only this origin may call the API with cookies.
CLIENT_URL=http://localhost:5173

# ---------- Auth (JWT in httpOnly cookies) ----------
# Two DIFFERENT random strings of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetime of the short access token and the long refresh token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------- ImageKit (homestay photos + private verification documents) ----------
# From https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# ---------- OpenRouteService (road route geometry + geocoding) ----------
# Free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ---------- Email (OTP codes) ----------
# Required only when OTP_DEV_MODE=false. Gmail: smtp.gmail.com, port 587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to users, e.g. "Explore Arunachal <no-reply@example.com>"
MAIL_FROM=

# true = print OTP codes in the server console instead of sending email/SMS (local dev only).
# Must be false in production.
OTP_DEV_MODE=true

# ---------- Seed ----------
# Password for the sample accounts created by `npm run seed` (admin, hosts, traveller).
# At least 8 characters with a number. Local/demo use only.
SEED_PASSWORD=

# ---------- Google login (optional, not built yet) ----------
# true shows "Continue with Google" on the login page
GOOGLE_AUTH_ENABLED=false
